{
  "name": "armadillo-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Protocol sidecar for Project Armadillo — bridges A2A and Zed ACP to the .NET Core's control API.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "acp": "tsx src/acp.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
